<body>
<div class="container">

<header class="header">
  <div class="header-content">
    <div class="brand">
      <div class="brand-logo">🏢</div>
      <div>
        <h1>RENTAL <span>MANAGEMENT</span></h1>
        <p>COLLECTION • ELECTRICITY • ANALYSIS • FINANCIAL OVERVIEW</p>
      </div>
    </div>
    <div class="header-actions">
      <span class="lock-badge" id="accessStatus">👁 View Only</span>
