.legend{display:flex;flex-direction:column;gap:14px}.legend-row{display:flex;align-items:center;gap:9px}.dot{width:10px;height:10px;border-radius:50%}.dot.green{background:var(--green)}.dot.red{background:var(--red)}.dot.gold{background:var(--gold)}.dot.blue{background:var(--blue)}
