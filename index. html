function exportData(){if(!isAdmin)return alert('Backup के लिए Admin Login जरूरी है।');let blob=new Blob([JSON.stringify({app:'RK Vishvkarma Rental Management',version:'4.1',exportedAt:new Date().toISOString(),rooms,payments,monthLedger,appMeta},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='rental-management-v4-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500);showToast('Complete backup downloaded ✓');}
function importData(e){if(!isAdmin)return alert('Restore के लिए Admin Login जरूरी है।');let f=e.target.files[0];if(!f)return;let rd=new FileReader();rd.onload=x=>{try{let d=JSON.parse(x.target.result);if(!Array.isArray(d.rooms))throw 0;rooms=d.rooms;payments=Array.isArray(d.payments)?d.payments:[];monthLedger=d.monthLedger||{};appMeta=d.appMeta||{activeMonth:monthKey()};normalizeRooms();save();updateDashboard();alert('Backup restored successfully.');}catch{alert('Invalid backup file.')}};rd.readAsText(f);e.target.value='';}
function toggleTheme(){document.body.classList.toggle('light');localStorage.setItem('rkTheme',document.body.classList.contains('light')?'light':'dark')}
function scrollToSection(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'});}
function openProfile(i){currentProfileIndex=i;const r=rooms[i];if(!r)return;const rp=Math.max(0,r.due-r.received),ep=Math.max(0,r.electricityDue-r.electricityReceived);profileContent.innerHTML=`<div class="profile-hero"><img class="profile-photo" src="${esc(r.photo||'')}" onerror="this.style.display='none'" alt=""><div class="profile-avatar">${esc((r.name||'R').trim().charAt(0))}</div><div><h3>${esc(r.name)}</h3><p>Room ${esc(r.room)} • ${esc(r.mobile||'Mobile not added')}</p></div></div><div class="profile-grid"><div><span>Room Rent</span><b>${money(r.due)}</b></div><div><span>Rent Paid</span><b class="paid-t">${money(r.received)}</b></div><div><span>Rent Balance</span><b class="due-t">${money(rp)}</b></div><div><span>Electricity Bill</span><b>${money(r.electricityDue)}</b></div><div><span>Electricity Paid</span><b class="paid-t">${money(r.electricityReceived)}</b></div><div><span>Electricity Balance</span><b class="due-t">${money(ep)}</b></div><div><span>Combined Due</span><b>${money(r.due+r.electricityDue)}</b></div><div><span>Combined Paid</span><b class="paid-t">${money(r.received+r.electricityReceived)}</b></div><div><span>Grand Balance</span><b class="due-t">${money(rp+ep)}</b></div></div><div style="margin-top:12px;padding:10px;border:1px solid rgba(128,145,165,.12);border-radius:10px"><span style="color:var(--muted);font-size:10px">Address</span><p style="margin-top:5px">${esc(r.address||'Not added')}</p></div>${r.driveLink?`<div class="form-actions"><a class="btn drive-btn" href="${esc(r.driveLink)}" target="_blank" rel="noopener">📁 Open Google Drive Profile</a></div>`:`<div class="profile-drive-edit"><b>📁 Google Drive Profile</b><div style="font-size:10px;color:var(--muted);margin-top:4px">Admin login के बाद यहां Google Drive profile/documents link attach किया जा सकता है।</div></div>`}<div class="form-actions"><button class="btn" onclick="openPaymentModal(${i},'combined')">💳 View / Record Payment</button>${isAdmin?`<button class="btn gold" onclick="openRenterEditor(${i})">✏️ Edit Profile</button>`:''}</div>`;profileActions.innerHTML='';profileModal.classList.add('show');}
function closeProfile(){profileModal.classList.remove('show')}
function openRenterEditor(i=0){if(!isAdmin)return;editRenterRoom.innerHTML=rooms.map((r,j)=>`<option value="${j}">${esc(r.room)} — ${esc(r.name)}</option>`).join('');editRenterRoom.value=String(i||0);loadRenterEditor();renterEditorModal.classList.add('show');}
function closeRenterEditor(){renterEditorModal.classList.remove('show')}
function loadRenterEditor(){const i=+editRenterRoom.value,r=rooms[i];renterEditorContent.innerHTML=`<div class="profile-edit-grid"><div><img class="profile-photo" src="${esc(r.photo||'')}" onerror="this.style.display='none'"><div class="form-group" style="margin-top:7px"><label>Profile Photo URL</label><input id="editPhoto" value="${esc(r.photo||'')}" placeholder="https://..."></div></div><div class="profile-fields"><div><label>Name</label><input id="editName" value="${esc(r.name)}"></div><div><label>Mobile</label><input id="editMobile" value="${esc(r.mobile||'')}" placeholder="10 digit mobile"></div><div class="full"><label>Address</label><textarea id="editAddress" rows="2">${esc(r.address||'')}</textarea></div><div class="full"><label>📁 Google Drive Profile / Documents Link</label><div class="drive-row"><input id="editDrive" type="url" value="${esc(r.driveLink||'')}" placeholder="https://drive.google.com/...">${r.driveLink?`<a class="btn drive-btn" href="${esc(r.driveLink)}" target="_blank" rel="noopener">Open</a>`:''}</div><small style="color:var(--muted);display:block;margin-top:5px">Admin यहां renter के Google Drive folder/file का share link attach कर सकता है।</small></div></div></div><div class="form-actions"><button class="btn red" onclick="deleteRenterProfile(${i})">🗑 Delete Renter</button><button class="btn gold" onclick="saveRenterProfile(${i})">Save Profile</button></div>`;}
function saveRenterProfile(i){if(!isAdmin)return;Object.assign(rooms[i],{name:editName.value.trim(),mobile:editMobile.value.trim(),address:editAddress.value.trim(),photo:editPhoto.value.trim(),driveLink:editDrive.value.trim()});save();updateDashboard();loadRenterEditor();showToast('Renter profile updated ✓');}
function deleteRenterProfile(i){if(!isAdmin)return;if(confirm(`Delete ${rooms[i].name} and room ${rooms[i].room}? This also removes current renter data.`)){rooms.splice(i,1);save();updateDashboard();closeRenterEditor();showToast('Renter deleted');}}
function openPaymentModal(i=0,type='rent'){if(!isAdmin)return;payRoom.innerHTML=rooms.map((r,j)=>`<option value="${j}">${esc(r.room)} — ${esc(r.name)}</option>`).join('');payRoom.value=String(i||0);payType.value=type;payDate.value=today();payTime.value=nowTime();payAmount.value='';payNote.value='';paymentModal.classList.add('show');}
function closePaymentModal(){paymentModal.classList.remove('show')}
async function digest(text){const data=new TextEncoder().encode(text),hash=await crypto.subtle.digest('SHA-256',data);return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,'0')).join('').slice(0,16).toUpperCase();}
async function savePayment(){if(!isAdmin)return;const i=+payRoom.value,r=rooms[i],amount=Number(payAmount.value);if(!r||amount<=0)return alert('Valid payment amount भरें।');const type=payType.value,method=payMethod.value,date=payDate.value||today(),time=payTime.value||nowTime();let rem=amount;if(type==='rent'||type==='combined'){const p=Math.max(0,r.due-r.received);const x=Math.min(rem,p);r.received+=x;rem-=x;}if((type==='electricity'||type==='combined')&&rem>0){const p=Math.max(0,r.electricityDue-r.electricityReceived);const x=Math.min(rem,p);r.electricityReceived+=x;rem-=x;}if(rem>0)return alert('Payment amount current outstanding से अधिक है। Advance payment के लिए अलग entry बनाएं।');const id='RK-'+date.replaceAll('-','')+'-'+String(Date.now()).slice(-6);const payload=`${id}|${r.room}|${r.name}|${amount}|${date}|${time}|${method}`;const fingerprint=await digest(payload);payments.unshift({id,room:r.room,name:r.name,type,amount,method,date,time,note:payNote.value.trim(),fingerprint});snapshotMonth(appMeta.activeMonth);save();updateDashboard();closePaymentModal();openReceipt(payments[0]);showToast('Payment recorded & receipt generated ✓');}
function openReceipt(p){currentReceipt=p;const r=rooms.find(x=>String(x.room)===String(p.room));const rp=r?Math.max(0,r.due-r.received):0,ep=r?Math.max(0,r.electricityDue-r.electricityReceived):0;receiptPreview.innerHTML=`<div class="receipt-preview"><div class="receipt-head"><div><h3>RENTAL PAYMENT RECEIPT</h3><small>RK Vishvkarma Rental Management</small></div><div><b>${esc(p.id)}</b><br><small>${esc(p.date)} ${esc(p.time)}</small></div></div><div class="receipt-grid"><div><small>Renter</small><b>${esc(p.name)}</b></div><div><small>Room</small><b>${esc(p.room)}</b></div><div><small>Payment Type</small><b>${esc(p.type.toUpperCase())}</b></div><div><small>Method</small><b>${esc(p.method)}</b></div><div><small>Amount Received</small><b>${money(p.amount)}</b></div><div><small>Reference</small><b>${esc(p.note||'—')}</b></div><div><small>Current Rent Balance</small><b>${money(rp)}</b></div><div><small>Current Electricity Balance</small><b>${money(ep)}</b></div></div><div class="receipt-total">Received: ${money(p.amount)}</div><div class="qr-wrap" id="receiptQR"></div><div class="qr-note">Scan to verify receipt data & fingerprint. Receipt ID: ${esc(p.id)} • Fingerprint: ${esc(p.fingerprint)}<br>Client-side QR is tamper-evident; server verification is required for cryptographic anti-fraud guarantees.</div><div style="text-align:center;margin-top:10px;font-size:10px">Digitally Signed — Mr. RK Vishvkarma</div></div>`;receiptModal.classList.add('show');setTimeout(()=>{receiptQR.innerHTML='';if(window.QRCode)new QRCode(receiptQR,{text:JSON.stringify({receiptId:p.id,room:p.room,renter:p.name,amount:p.amount,type:p.type,date:p.date,time:p.time,method:p.method,fingerprint:p.fingerprint}),width:150,height:150,correctLevel:QRCode.CorrectLevel.H});},50);}
function closeReceipt(){receiptModal.classList.remove('show')}
function renderReceiptPrint(p){const r=rooms.find(x=>String(x.room)===String(p.room));const rp=r?Math.max(0,r.due-r.received):0,ep=r?Math.max(0,r.electricityDue-r.electricityReceived):0;receiptPrintContent.innerHTML=`<div style="max-width:700px;margin:20px auto;border:1px solid #bbb;padding:20px"><div style="display:flex;justify-content:space-between;border-bottom:2px solid #222;padding-bottom:10px"><div><h1 style="font-size:22px;margin:0">RENTAL PAYMENT RECEIPT</h1><small>RK Vishvkarma Rental Management</small></div><div style="text-align:right"><b>${esc(p.id)}</b><br>${esc(p.date)} ${esc(p.time)}</div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0"><div>Renter<br><b>${esc(p.name)}</b></div><div>Room<br><b>${esc(p.room)}</b></div><div>Type<br><b>${esc(p.type)}</b></div><div>Method<br><b>${esc(p.method)}</b></div><div>Amount Received<br><b>${money(p.amount)}</b></div><div>Reference<br><b>${esc(p.note||'—')}</b></div><div>Rent Balance<br><b>${money(rp)}</b></div><div>Electricity Balance<br><b>${money(ep)}</b></div></div><div style="text-align:right;font-size:18px;font-weight:800">TOTAL RECEIVED: ${money(p.amount)}</div><div style="text-align:center;margin:14px"><div id="printReceiptQR"></div><small>Receipt ID: ${esc(p.id)} • Fingerprint: ${esc(p.fingerprint)}</small></div><p style="font-size:9px;color:#555">QR contains the receipt payload and SHA-256 fingerprint. For real cryptographic anti-fraud verification, a server-side public-key signature/verification endpoint is required.</p></div>`;setTimeout(()=>{if(window.QRCode){printReceiptQR.innerHTML='';new QRCode(printReceiptQR,{text:JSON.stringify({receiptId:p.id,room:p.room,renter:p.name,amount:p.amount,type:p.type,date:p.date,time:p.time,method:p.method,fingerprint:p.fingerprint}),width:170,height:170,correctLevel:QRCode.CorrectLevel.H});}},50)}
function printReceipt(){if(!currentReceipt)return;renderReceiptPrint(currentReceipt);document.body.classList.add('receipt-print-mode');setTimeout(()=>{window.print();},180)}
function openHistory(){populateHistoryMonths();renderHistory();historyModal.classList.add('show')}
function closeHistory(){historyModal.classList.remove('show')}
function populateHistoryMonths(){const keys=Object.keys(monthLedger).sort().reverse();historyMonth.innerHTML=keys.map(k=>`<option value="${k}">${k}</option>`).join('');if(!keys.length)historyMonth.innerHTML=`<option value="${appMeta.activeMonth}">${appMeta.activeMonth}</option>`;}
function renderHistory(){const key=historyMonth.value||appMeta.activeMonth,rows=monthLedger[key]||[],sum=rows.reduce((a,r)=>{a.rd+=r.due;a.rp+=r.received;a.ed+=r.electricityDue;a.ep+=r.electricityReceived;return a},{rd:0,rp:0,ed:0,ep:0});historySummary.innerHTML=`<div class="history-summary"><div><small>Rent Paid</small><b>${money(sum.rp)}</b></div><div><small>Rent Balance</small><b class="due-t">${money(Math.max(0,sum.rd-sum.rp))}</b></div><div><small>Electricity Paid</small><b>${money(sum.ep)}</b></div><div><small>Grand Balance</small><b class="due-t">${money(Math.max(0,sum.rd-sum.rp)+Math.max(0,sum.ed-sum.ep))}</b></div></div>`;historyRows.innerHTML=rows.map(r=>`<tr><td>${esc(r.room)}</td><td>${esc(r.name)}</td><td class="${r.rentArrear?'arrear-cell':''}">${money(r.due)}${r.rentArrear?`<span class="arrear-badge">↗ ₹${money(r.rentArrear)}</span>`:''}</td><td>${money(r.received)}</td><td>${money(Math.max(0,r.due-r.received))}</td><td class="${r.electricityArrear?'arrear-cell':''}">${money(r.electricityDue)}${r.electricityArrear?`<span class="arrear-badge">↗ ₹${money(r.electricityArrear)}</span>`:''}</td><td>${money(r.electricityReceived)}</td><td>${money(Math.max(0,r.electricityDue-r.electricityReceived))}</td><td><b>${money(Math.max(0,r.due-r.received)+Math.max(0,r.electricityDue-r.electricityReceived))}</b></td></tr>`).join('');}
function printHistory(){renderPrintV4();window.print()}
function openPaymentHistory(){populatePaymentMonths();renderPaymentHistory();paymentHistoryModal.classList.add('show')}
function closePaymentHistory(){paymentHistoryModal.classList.remove('show')}
function populatePaymentMonths(){const ks=[...new Set(payments.map(p=>p.date?.slice(0,7)).filter(Boolean))].sort().reverse();paymentMonth.innerHTML='<option value="all">All Months</option>'+ks.map(k=>`<option>${k}</option>`).join('');}
function renderPaymentHistory(){const q=(paymentFilter.value||'').toLowerCase().trim(),m=paymentMonth.value||'all',rows=payments.filter(p=>(m==='all'||p.date?.startsWith(m))&&(!q||`${p.name} ${p.room} ${p.id}`.toLowerCase().includes(q)));const total=rows.reduce((s,p)=>s+p.amount,0);paymentSummary.innerHTML=`<div class="history-summary"><div><small>Transactions</small><b>${rows.length}</b></div><div><small>Total Received</small><b>${money(total)}</b></div><div><small>UPI</small><b>${money(rows.filter(p=>p.method==='UPI').reduce((s,p)=>s+p.amount,0))}</b></div><div><small>Cash</small><b>${money(rows.filter(p=>p.method==='Cash').reduce((s,p)=>s+p.amount,0))}</b></div></div>`;paymentRows.innerHTML=rows.map(p=>`<tr><td>${esc(p.date)}</td><td>${esc(p.time)}</td><td>${esc(p.id)}</td><td><button class="renter-link" onclick="openProfile(${rooms.findIndex(r=>String(r.room)===String(p.room))})">${esc(p.name)}</button></td><td>${esc(p.room)}</td><td>${esc(p.type)}</td><td><b>${money(p.amount)}</b></td><td><span class="method-badge ${p.method==='UPI'?'upi':p.method==='Cash'?'cash':'other'}">${esc(p.method)}</span></td><td><button class="action-btn" onclick='openReceipt(${JSON.stringify(p).replaceAll("'","&#039;")})'>🧾 View</button></td></tr>`).join('');}
function renderPrintV4(){const c=calculate();pvDate.textContent=new Date().toLocaleString('en-IN');pvRentRows.innerHTML=rooms.map(r=>`<tr><td>${esc(r.room)}</td><td>${r.driveLink?`<a href="${esc(r.driveLink)}">${esc(r.name)}</a>`:esc(r.name)}</td><td class="${r.rentArrear?'arrear-cell':''}">${money(r.due)}${r.rentArrear?`<span class="arrear-badge">↗ ₹${money(r.rentArrear)}</span>`:''}</td><td>${money(r.received)}</td><td>${money(Math.max(0,r.due-r.received))}</td></tr>`).join('');pvElecRows.innerHTML=rooms.map(r=>`<tr><td>${esc(r.room)}</td><td>${r.driveLink?`<a href="${esc(r.driveLink)}">${esc(r.name)}</a>`:esc(r.name)}</td><td>${Number(r.kwh||0).toLocaleString('en-IN',{maximumFractionDigits:2})}</td><td>₹${Number(r.ratePerKwh||0).toLocaleString('en-IN',{maximumFractionDigits:2})}</td><td class="${r.electricityArrear?'arrear-cell':''}">${money(r.electricityDue)}${r.electricityArrear?`<span class="arrear-badge">↗ ₹${money(r.electricityArrear)}</span>`:''}</td><td>${money(r.electricityReceived)}</td><td>${money(Math.max(0,r.electricityDue-r.electricityReceived))}</td></tr>`).join('');pvCombinedRows.innerHTML=rooms.map(r=>`<tr><td>${esc(r.room)}</td><td>${r.driveLink?`<a href="${esc(r.driveLink)}">${esc(r.name)}</a>`:esc(r.name)}</td><td class="${r.rentArrear?'arrear-cell':''}">${money(r.due)}${r.rentArrear?`<span class="arrear-badge">↗ ₹${money(r.rentArrear)}</span>`:''}</td><td>${money(r.received)}</td><td>${money(Math.max(0,r.due-r.received))}</td><td class="${r.electricityArrear?'arrear-cell':''}">${money(r.electricityDue)}${r.electricityArrear?`<span class="arrear-badge">↗ ₹${money(r.electricityArrear)}</span>`:''}</td><td>${money(r.electricityReceived)}</td><td>${money(Math.max(0,r.electricityDue-r.electricityReceived))}</td><td><b>${money(Math.max(0,r.due-r.received)+Math.max(0,r.electricityDue-r.electricityReceived))}</b></td></tr>`).join('');pvPaymentRows.innerHTML=payments.slice(0,30).map(p=>`<tr><td>${esc(p.date)}</td><td>${esc(p.time)}</td><td>${esc(p.id)}</td><td>${esc(p.name)}</td><td>${esc(p.room)}</td><td>${esc(p.type)}</td><td>${money(p.amount)}</td><td>${esc(p.method)}</td></tr>`).join('');}
function showToast(m){toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2200)}
window.addEventListener('beforeprint',()=>{if(document.body.classList.contains('receipt-print-mode'))renderReceiptPrint(currentReceipt);else renderPrintV4();});window.addEventListener('afterprint',()=>document.body.classList.remove('receipt-print-mode'));
if(localStorage.getItem('rkTheme')==='light')document.body.classList.add('light');
updateDashboard();renderAllTables();
</script>
