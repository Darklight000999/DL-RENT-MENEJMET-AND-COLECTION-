 renderDueList();
 renderInsights();

}


/* ================= STATUS ================= */

function getStatus(r){

 const due=Number(r.due||0);
 const paid=Number(r.received||0);

 if(paid>=due && due>0)
  return ["paid","🟢 पूरा जमा"];

 if(paid>0)
  return ["partial","🟠 आंशिक"];

 return ["due","🔴 बकाया"];

}


/* ================= TABLE ================= */

function renderTable(){

 const search=
  document.getElementById("search")
  .value.toLowerCase().trim();

 const filtered=
  rooms.filter(r=>
   String(r.room).toLowerCase()
    .includes(search) ||
   String(r.name).toLowerCase()
    .includes(search)
  );

 const tbody=
  document.getElementById("roomTable");

 tbody.innerHTML="";


 filtered.forEach(room=>{

  const index=rooms.indexOf(room);

  const rentDue=
   Number(room.due||0);

  const rentPaid=
   Number(room.received||0);

  const rentPending=
   Math.max(0,rentDue-rentPaid);


  const units=
   Number(room.units||0);

  const rate=
   Number(room.rate||0);

  let bill=
   Number(room.electricBill||0);

  if(bill<=0 && units>0)
   bill=units*rate;

  const electricPaid=
   Number(room.electricPaid||0);

  const electricPending=
   Math.max(0,bill-electricPaid);


  const status=getStatus(room);


  const tr=document.createElement("tr");


  /* VIEWER MODE = normal text
     ADMIN MODE = editable input
  */

  const nameCell=isAdmin
   ? `<input class="edit-input"
       value="${escapeHTML(room.name)}"
       onchange="updateRoom(${index},'name',this.value)">`
   : escapeHTML(room.name);


  const rentDueCell=isAdmin
   ? `<input class="edit-input"
       type="number"
       value="${rentDue}"
       onchange="updateRoom(${index},'due',this.value)">`
   : money(rentDue);


  const rentPaidCell=isAdmin
   ? `<input class="edit-input"
       type="number"
       value="${rentPaid}"
       onchange="updateRoom(${index},'received',this.value)">`
   : money(rentPaid);


  const unitsCell=isAdmin
   ? `<input class="edit-input"
       type="number"
       step="0.01"
       value="${units}"
       onchange="updateRoom(${index},'units',this.value)">`
   : units;


  const rateCell=isAdmin
   ? `<input class="edit-input"
       type="number"
       step="0.01"
       value="${rate}"
       onchange="updateRoom(${index},'rate',this.value)">`
   : money(rate);


  const billCell=isAdmin
   ? `<input class="edit-input"
       type="number"
       value="${bill}"
       onchange="updateRoom(${index},'electricBill',this.value)">`
   : money(bill);


  const electricPaidCell=isAdmin
   ? `<input class="edit-input"
       type="number"
       value="${electricPaid}"
       onchange="updateRoom(${index},'electricPaid',this.value)">`
   : money(electricPaid);


  tr.innerHTML=`

   <td class="room">
    ${escapeHTML(room.room)}
   </td>

   <td>${nameCell}</td>

   <td>${rentDueCell}</td>

   <td>${rentPaidCell}</td>

   <td class="${rentPending>0?'pending-red':'paid-green'}">
    ${money(rentPending)}
   </td>

   <td class="electricity">
    ${unitsCell}
   </td>

   <td class="electricity">
    ${rateCell}
   </td>

   <td class="electricity">
    ${billCell}
   </td>

   <td class="electricity">
    ${electricPaidCell}
   </td>

   <td class="${electricPending>0?'pending-red':'paid-green'}">
    ${money(electricPending)}
   </td>

   <td>
    <span class="status ${status[0]}">
     ${status[1]}
    </span>
   </td>

   <td>

    ${
     isAdmin
      ? `<button
          class="btn red"
          style="padding:6px 8px"
          onclick="deleteRoom(${index})">
          🗑
         </button>`
      : `<span style="
          color:var(--muted);
          font-size:10px">
          🔒 View Only
         </span>`
    }

   </td>

  `;

  tbody.appendChild(tr);

 });


 const c=calculate();

 const total=document.createElement("tr");

 total.className="total-row";

 total.innerHTML=`

  <td>TOTAL</td>

  <td>${rooms.length} ROOMS</td>

  <td>${money(c.rentDue)}</td>

  <td>${money(c.rentPaid)}</td>

  <td>${money(c.rentPending)}</td>

  <td>—</td>

  <td>—</td>

  <td>${money(c.electricity)}</td>

  <td>${money(c.electricPaid)}</td>

  <td>${money(c.electricPending)}</td>

  <td colspan="2">
   TOTAL OUTSTANDING:
   ${money(c.totalPending)}
  </td>

 `;

 tbody.appendChild(total);

}


/* ================= UPDATE ================= */

function updateRoom(index,key,value){

 if(!isAdmin){
  showToast("🔒 Admin Login Required");
  return;
 }

 if(key==="name"){
  rooms[index][key]=value;
 }else{
  rooms[index][key]=Math.max(
   0,
   Number(value)||0
  );
 }

 save();
 updateDashboard();
 renderTable();

 showToast("✓ Data Updated");

}


/* ================= DELETE ================= */

function deleteRoom(index){

 if(!isAdmin){
  showToast("🔒 Admin Login Required");
  return;
 }

 const r=rooms[index];

 if(!confirm(
  `Room ${r.room} — ${r.name}\n\nकमरा delete करें?`
 )) return;

 rooms.splice(index,1);

 save();
 updateDashboard();
 renderTable();

 showToast("Room Deleted");

}


/* ================= ADD ROOM ================= */

function openAddModal(){

 if(!isAdmin){
  showToast("🔒 Admin Login Required");
  return;
 }

 document.getElementById("addModal")
 .classList.add("show");

}


function closeAddModal(){

 document.getElementById("addModal")
 .classList.remove("show");

}


function addRoom(){

 if(!isAdmin){
  showToast("🔒 Admin Login Required");
  return;
 }

 const room=
  document.getElementById("newRoom")
  .value.trim();

 const name=
  document.getElementById("newName")
  .value.trim();

 const due=
  Number(document.getElementById("newDue").value);

 const received=
  Number(document.getElementById("newReceived").value);

 const units=
  Number(document.getElementById("newUnits").value);

 const rate=
  Number(document.getElementById("newRate").value);

 const electricBill=
  Number(document.getElementById("newElectricBill").value);

 const electricPaid=
  Number(document.getElementById("newElectricPaid").value);


 if(!room || !name || due<=0){

  alert("Room, Name और Rent भरना जरूरी है।");
  return;

 }


 if(
  rooms.some(
   r=>String(r.room)===String(room)
  )
 ){

  alert("यह Room Number पहले से मौजूद है।");
  return;

 }


 rooms.push({

  room,
  name,
  due,
  received:Math.max(0,received),

  units:Math.max(0,units),

  rate:Math.max(0,rate),

  electricBill:
   Math.max(0,electricBill),

  electricPaid:
   Math.max(0,electricPaid)

 });


 save();
 updateDashboard();
 renderTable();

 closeAddModal();

 [
  "newRoom",
  "newName",
  "newDue"
 ].forEach(id=>{
  document.getElementById(id).value="";
 });

 document.getElementById("newReceived").value="0";
 document.getElementById("newUnits").value="0";
 document.getElementById("newRate").value="8";
 document.getElementById("newElectricBill").value="0";
 document.getElementById("newElectricPaid").value="0";

 showToast(`Room ${room} Added ✓`);

}


/* ================= DUE LIST ================= */

function renderDueList(){

 const list=
  document.getElementById("dueList");

 const dues=[];

 rooms.forEach(r=>{

  const rent=
   Math.max(
    0,
    Number(r.due||0)-
    Number(r.received||0)
   );

  const units=
   Number(r.units||0);

  const rate=
   Number(r.rate||0);

  let bill=
   Number(r.electricBill||0);

  if(bill<=0 && units>0)
   bill=units*rate;

  const electric=
   Math.max(
    0,
    bill-Number(r.electricPaid||0)
   );

  const total=rent+electric;

  if(total>0){

   dues.push({
    ...r,
    pending:total
   });

  }

 });


 dues.sort(
  (a,b)=>b.pending-a.pending
 );

 list.innerHTML="";


 if(!dues.length){

  list.innerHTML=`
   <div style="
    text-align:center;
    padding:25px;
    color:var(--green)">
    🎉 कोई Outstanding नहीं है।
   </div>
  `;

  return;

 }


 dues.forEach((r,i)=>{

  const item=
   document.createElement("div");

  item.className="due-item";

  item.innerHTML=`

   <div class="due-left">

    <div class="priority">
     ${i+1}
    </div>

    <div>

     <div class="due-name">
      ${escapeHTML(r.name)}
     </div>

     <div class="due-room">
      Room ${escapeHTML(r.room)}
     </div>

    </div>

   </div>

   <div class="due-money">
    ${money(r.pending)}
   </div>

  `;

  list.appendChild(item);

 });

}


