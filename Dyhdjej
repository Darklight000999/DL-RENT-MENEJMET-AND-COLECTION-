  ">

   Total Collection Target:

   <strong style="color:var(--gold2)">
    ${money(c.rentDue+c.electricity)}
   </strong>

  </div>

 </div>

 `;

}


/* ================= SORT ================= */

function sortByDue(){

 rooms.sort((a,b)=>{

  const aRent=
   Number(a.due||0)-Number(a.received||0);

  const bRent=
   Number(b.due||0)-Number(b.received||0);

  return bRent-aRent;

 });

 renderTable();

 showToast("Sorted by Outstanding");

}


/* ================= BACKUP ================= */

function exportData(){

 if(!isAdmin){
  showToast("🔒 Admin Login Required");
  return;
 }

 const data={
  app:"darklight000999 Rental Management",
  version:"2.0",
  exportedAt:new Date().toISOString(),
  rooms
 };

 const blob=new Blob(
  [JSON.stringify(data,null,2)],
  {type:"application/json"}
 );

 const url=
  URL.createObjectURL(blob);

 const a=document.createElement("a");

 a.href=url;

 a.download=
  "rental-management-backup.json";

 a.click();

 URL.revokeObjectURL(url);

 showToast("Backup Downloaded ✓");

}


/* ================= RESTORE ================= */

function importData(event){

 if(!isAdmin){
  showToast("🔒 Admin Login Required");
  return;
 }

 const file=
  event.target.files[0];

 if(!file)return;

 const reader=
  new FileReader();

 reader.onload=e=>{

  try{

   const data=
    JSON.parse(e.target.result);

   if(!Array.isArray(data.rooms))
    throw new Error();

   if(!confirm(
    "Existing data replace करें?"
   )) return;

   rooms=data.rooms;

   save();
   updateDashboard();
   renderTable();

   showToast("Backup Restored ✓");

  }catch{

   alert("Invalid backup file.");

  }

 };

 reader.readAsText(file);

}


/* ================= THEME ================= */

function toggleTheme(){

 const current=
  document.documentElement
  .getAttribute("data-theme");

 const next=
  current==="light"
   ? "dark"
   : "light";

 document.documentElement
 .setAttribute(
  "data-theme",
  next
 );

 localStorage.setItem(
  "rentalTheme",
  next
 );

 document.getElementById("themeBtn")
 .textContent=
  next==="light"
   ? "🌙 Dark"
   : "☀️ Light";

}


/* ================= TOAST ================= */

function showToast(message){

 const toast=
  document.getElementById("toast");

 toast.textContent=message;

 toast.classList.add("show");

 setTimeout(()=>{
  toast.classList.remove("show");
 },2200);

}


/* ================= INIT ================= */

function init(){

 const savedTheme=
  localStorage.getItem("rentalTheme")
  || "dark";

 document.documentElement
 .setAttribute(
  "data-theme",
  savedTheme
 );

 document.getElementById("themeBtn")
 .textContent=
  savedTheme==="light"
   ? "🌙 Dark"
   : "☀️ Light";

 applyAdminMode();

 updateDashboard();

 renderTable();

}


init();

</script>

