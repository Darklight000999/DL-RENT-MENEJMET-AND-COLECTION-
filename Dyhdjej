 document.getElementById(
  "electricityPendingBar"
 ).style.width=
  ePendingPercent+"%";

 document.getElementById(
  "electricityGraphTotal"
 ).textContent=
  money(c.electricity);


 /* STATUS */

 const total=
  Math.max(rooms.length,1);

 document.getElementById("fullyPaid")
 .textContent=c.paid;

 document.getElementById("partialPaid")
 .textContent=c.partial;

 document.getElementById("unpaid")
