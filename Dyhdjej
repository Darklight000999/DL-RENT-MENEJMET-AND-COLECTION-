<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#05070b">

<title>Rental Management System — darklight000999</title>

<style>
:root{
 --bg:#05070b;
 --panel:#0b1018;
 --panel2:#101722;
 --text:#f5f7fb;
 --muted:#8d98a8;
 --border:rgba(245,196,81,.22);
 --gold:#f5c451;
 --gold2:#ffdf78;
 --green:#18e889;
 --red:#ff4757;
 --orange:#ffb020;
 --cyan:#19d8ff;
 --blue:#4f8cff;
 --shadow:0 18px 55px rgba(0,0,0,.45);
}

[data-theme="light"]{
 --bg:#f4f6f9;
 --panel:#ffffff;
 --panel2:#f7f9fc;
 --text:#111827;
 --muted:#64748b;
 --border:rgba(180,130,20,.28);
 --gold:#b77900;
 --gold2:#9a6500;
 --shadow:0 12px 35px rgba(0,0,0,.10);
}

*{box-sizing:border-box;margin:0;padding:0}

body{
 background:
 radial-gradient(circle at 10% 0%,rgba(245,196,81,.10),transparent 30%),
 radial-gradient(circle at 90% 20%,rgba(25,216,255,.07),transparent 28%),
 var(--bg);
 color:var(--text);
 font-family:Inter,Segoe UI,Arial,sans-serif;
 min-height:100vh;
 transition:.25s;
}

button,input{font:inherit}
button{cursor:pointer}

.container{
 width:min(1550px,95%);
 margin:auto;
}

/* HEADER */

.header{
 margin:18px 0;
 padding:22px 26px;
 border:1px solid var(--border);
 border-radius:24px;
 background:linear-gradient(145deg,var(--panel),var(--panel2));
 box-shadow:var(--shadow);
}

.header-content{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:20px;
}

.brand{
 display:flex;
 align-items:center;
 gap:15px;
}

.brand-logo{
 width:62px;
 height:62px;
 border-radius:17px;
 display:grid;
 place-items:center;
 font-size:29px;
 border:1px solid var(--border);
 background:linear-gradient(145deg,#211a08,var(--panel));
}

.brand h1{
 font-size:clamp(22px,3vw,35px);
 letter-spacing:1px;
}

.brand h1 span{color:var(--gold)}

.brand p{
 color:var(--muted);
 font-size:12px;
 letter-spacing:1px;
 margin-top:5px;
}

.header-actions{
 display:flex;
 gap:8px;
 flex-wrap:wrap;
 justify-content:flex-end;
}

/* BUTTONS */

.btn{
 border:1px solid rgba(255,255,255,.10);
 background:var(--panel2);
 color:var(--text);
 border-radius:10px;
 padding:10px 14px;
 transition:.2s;
}

.btn:hover{
 transform:translateY(-2px);
 border-color:var(--gold);
}

.btn.gold{
 background:linear-gradient(135deg,#d59d22,#f5c451);
 color:#090b0f;
 border:0;
 font-weight:800;
}

.btn.green{
 color:var(--green);
 border-color:rgba(24,232,137,.3);
 background:rgba(24,232,137,.08);
}

.btn.red{
 color:#ff6875;
 border-color:rgba(255,71,87,.3);
}

.btn.blue{
 color:var(--cyan);
 border-color:rgba(25,216,255,.3);
}

/* ADMIN STATUS */

.admin-status{
 display:none;
 padding:8px 11px;
 border-radius:20px;
 font-size:11px;
 font-weight:800;
 color:var(--green);
 background:rgba(24,232,137,.08);
 border:1px solid rgba(24,232,137,.25);
}

body.admin .admin-status{display:inline-flex}

/* KPI */

.kpis{
 display:grid;
 grid-template-columns:repeat(8,1fr);
 gap:12px;
 margin-bottom:16px;
}

.kpi{
 min-height:118px;
 padding:17px;
 border-radius:17px;
 border:1px solid var(--border);
 background:linear-gradient(145deg,var(--panel),var(--panel2));
 box-shadow:var(--shadow);
}

.kpi-title{
 color:var(--muted);
 font-size:11px;
 text-transform:uppercase;
 letter-spacing:.7px;
}

.kpi-value{
 font-size:24px;
 font-weight:850;
 margin-top:12px;
}

.kpi-sub{
 color:var(--muted);
 font-size:10px;
 margin-top:5px;
}

/* GRID */

.grid{
 display:grid;
 grid-template-columns:1.4fr 1fr 1fr;
 gap:15px;
 margin-bottom:16px;
}

.card{
 background:linear-gradient(145deg,var(--panel),var(--panel2));
 border:1px solid rgba(255,255,255,.07);
 border-radius:19px;
 padding:19px;
 box-shadow:var(--shadow);
}

.card h2{
 font-size:16px;
 color:var(--gold2);
 margin-bottom:17px;
}

.card h2 span{
 color:var(--muted);
 font-size:10px;
 font-weight:400;
}

/* DONUT */

.donut-wrap{
 display:flex;
 justify-content:center;
 align-items:center;
 gap:30px;
}

.donut{
 width:175px;
 height:175px;
 border-radius:50%;
 background:conic-gradient(
   var(--green) 0deg,
   var(--green) calc(var(--collection)*1deg),
   var(--red) calc(var(--collection)*1deg),
   var(--red) 360deg
 );
 display:grid;
 place-items:center;
 position:relative;
}

.donut:after{
 content:"";
 position:absolute;
 width:118px;
 height:118px;
 border-radius:50%;
 background:var(--panel);
}

.donut-center{
 z-index:2;
 text-align:center;
}

.donut-center strong{
 display:block;
 font-size:26px;
}

.donut-center small{
 color:var(--muted);
}

.legend{
 display:grid;
 gap:12px;
}

.legend-row{
 display:flex;
 align-items:center;
 gap:8px;
}

.dot{
 width:10px;
 height:10px;
 border-radius:50%;
}

.dot.green{background:var(--green)}
.dot.red{background:var(--red)}
.dot.gold{background:var(--gold)}
.dot.cyan{background:var(--cyan)}

/* BARS */

.bar-row{margin:14px 0}

.bar-head{
 display:flex;
 justify-content:space-between;
 font-size:12px;
 margin-bottom:6px;
}

.bar{
 height:9px;
 background:rgba(127,127,127,.15);
 border-radius:20px;
 overflow:hidden;
}

.bar-fill{
 height:100%;
 width:0;
 border-radius:20px;
 transition:.5s;
}

/* TABLE */

.table-card{
 padding:0;
 overflow:hidden;
 margin-bottom:16px;
}

.table-header{
 padding:18px;
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:12px;
 border-bottom:1px solid rgba(255,255,255,.07);
}

.table-tools{
 display:flex;
 gap:7px;
 flex-wrap:wrap;
}

.search{
 width:230px;
 background:var(--panel2);
 border:1px solid rgba(255,255,255,.10);
 color:var(--text);
 padding:10px 12px;
 border-radius:9px;
 outline:none;
}

.table-wrap{overflow:auto}

table{
 width:100%;
 min-width:1350px;
 border-collapse:collapse;
}

thead{
 background:rgba(245,196,81,.07);
}

th{
 padding:12px;
 text-align:left;
 color:var(--gold2);
 font-size:11px;
 white-space:nowrap;
}

td{
 padding:9px 12px;
 border-top:1px solid rgba(255,255,255,.055);
 font-size:12px;
 white-space:nowrap;
}

tbody tr:hover{
 background:rgba(255,255,255,.025);
}

.room{
 color:var(--gold);
 font-weight:850;
}

.edit-input{
 width:105px;
 background:var(--panel2);
 border:1px solid rgba(255,255,255,.10);
 color:var(--text);
 border-radius:7px;
 padding:7px;
 outline:none;
}

.edit-input:disabled{
 opacity:.9;
 cursor:not-allowed;
}

.status{
 display:inline-flex;
 padding:5px 8px;
 border-radius:20px;
 font-size:10px;
 font-weight:800;
}

.status.paid{
 color:var(--green);
 background:rgba(24,232,137,.08);
}

.status.partial{
 color:var(--orange);
 background:rgba(255,176,32,.08);
}

.status.due{
 color:#ff6875;
 background:rgba(255,71,87,.08);
}

.electricity{
 color:var(--cyan);
 font-weight:800;
}

.pending-red{
 color:#ff6875;
 font-weight:850;
}

.paid-green{
 color:var(--green);
 font-weight:850;
}

.total-row{
 background:rgba(245,196,81,.06);
}

.total-row td{
 color:var(--gold2);
 font-weight:850;
}

/* DUES */

.dues{
 display:grid;
 gap:9px;
}

.due-item{
 display:flex;
 justify-content:space-between;
 align-items:center;
 padding:12px;
 border-radius:11px;
 background:var(--panel2);
 border:1px solid rgba(255,255,255,.06);
}

.due-left{
 display:flex;
 gap:10px;
 align-items:center;
}

.priority{
 width:29px;
 height:29px;
 display:grid;
 place-items:center;
 border-radius:8px;
 background:rgba(255,71,87,.12);
 color:#ff6875;
 font-weight:800;
}

.due-name{font-weight:700}

.due-room{
 color:var(--muted);
 font-size:10px;
}

.due-money{
 color:#ff6875;
 font-weight:850;
}

/* MODAL */

.modal{
 position:fixed;
 inset:0;
 display:none;
 align-items:center;
 justify-content:center;
 padding:20px;
 background:rgba(0,0,0,.78);
 backdrop-filter:blur(12px);
 z-index:1000;
}

.modal.show{display:flex}

.modal-box{
 width:min(620px,100%);
 max-height:90vh;
 overflow:auto;
 padding:23px;
 border-radius:21px;
 background:var(--panel);
 border:1px solid var(--border);
 box-shadow:0 30px 100px rgba(0,0,0,.7);
}

.modal-title{
 display:flex;
 justify-content:space-between;
 align-items:center;
 margin-bottom:18px;
}

.close{
 border:0;
 background:none;
 color:var(--text);
 font-size:23px;
}

.form-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:11px;
}

.form-group{
 display:flex;
 flex-direction:column;
 gap:5px;
}

.form-group.full{
 grid-column:1/-1;
}

.form-group label{
 font-size:11px;
 color:var(--muted);
}

.form-group input{
 background:var(--panel2);
 border:1px solid rgba(255,255,255,.10);
 color:var(--text);
 border-radius:9px;
 padding:10px;
 outline:none;
}

.form-actions{
 display:flex;
 justify-content:flex-end;
 gap:9px;
 margin-top:18px;
}

/* LOGIN */

.login-icon{
 width:55px;
 height:55px;
 margin:auto;
 border-radius:15px;
 display:grid;
 place-items:center;
 font-size:25px;
 background:rgba(245,196,81,.10);
 border:1px solid var(--border);
}

.login-note{
 margin-top:14px;
 padding:10px;
 border-radius:9px;
 background:rgba(255,176,32,.07);
 color:var(--muted);
 font-size:10px;
 line-height:1.5;
}

/* FOOTER */

.footer{
 margin:25px 0;
 padding:20px;
 text-align:center;
 color:var(--muted);
 font-size:11px;
 border-top:1px solid var(--border);
}

.footer strong{color:var(--gold)}

/* TOAST */

.toast{
 position:fixed;
 right:18px;
 bottom:18px;
 padding:12px 16px;
 border-radius:11px;
 background:var(--panel);
 border:1px solid var(--gold);
 color:var(--text);
 transform:translateY(100px);
 opacity:0;
 transition:.3s;
 z-index:2000;
}

.toast.show{
 transform:translateY(0);
 opacity:1;
}

/* RESPONSIVE */

@media(max-width:1300px){
 .kpis{grid-template-columns:repeat(4,1fr)}
 .grid{grid-template-columns:1fr 1fr}
}

@media(max-width:750px){
 .container{width:96%}
 .header-content{
   flex-direction:column;
   align-items:flex-start;
 }
 .header-actions{justify-content:flex-start}
 .kpis{grid-template-columns:1fr 1fr}
 .grid{grid-template-columns:1fr}
 .donut-wrap{flex-direction:column}
 .table-header{
   flex-direction:column;
   align-items:flex-start;
 }
 .search{width:100%}
 .form-grid{grid-template-columns:1fr}
 .form-group.full{grid-column:auto}
}

@media(max-width:430px){
 .kpis{grid-template-columns:1fr}
}
</style>
</head>

<body>

<div class="container">

<header class="header">

 <div class="header-content">

  <div class="brand">
   <div class="brand-logo">🏢</div>

   <div>
    <h1>RENTAL <span>MANAGEMENT</span></h1>
    <p>RENT • ELECTRICITY • COLLECTION • FINANCIAL CONTROL</p>
   </div>
  </div>

  <div class="header-actions">

   <span class="admin-status">
    🔐 ADMIN MODE
   </span>

   <button class="btn" onclick="toggleTheme()" id="themeBtn">
    ☀️ Light
   </button>

   <button class="btn blue" onclick="openLogin()">
    🔐 Admin Access
   </button>

   <button class="btn red" id="logoutBtn"
           onclick="logout()" style="display:none">
    Logout
   </button>

   <button class="btn gold admin-only"
           onclick="openAddModal()">
    ＋ नया कमरा
   </button>

   <button class="btn admin-only"
           onclick="exportData()">
    ↓ Backup
   </button>

   <button class="btn admin-only"
           onclick="document.getElementById('restoreFile').click()">
    ↑ Restore
   </button>

   <button class="btn green"
           onclick="window.print()">
    🖨 रिपोर्ट
   </button>

   <input
    type="file"
    id="restoreFile"
    accept=".json"
    hidden
    onchange="importData(event)"
   >

  </div>

 </div>

</header>


<!-- KPI -->

<section class="kpis">

 <div class="kpi">
  <div class="kpi-title">Total Rooms</div>
  <div class="kpi-value" id="totalRooms">0</div>
  <div class="kpi-sub">कुल कमरे</div>
 </div>

 <div class="kpi">
  <div class="kpi-title">Rent Expected</div>
  <div class="kpi-value" id="totalRent">₹0</div>
  <div class="kpi-sub">कुल किराया</div>
 </div>

 <div class="kpi">
  <div class="kpi-title">Rent Collected</div>
  <div class="kpi-value" id="rentCollected">₹0</div>
  <div class="kpi-sub">प्राप्त किराया</div>
 </div>

 <div class="kpi">
  <div class="kpi-title">Rent Pending</div>
  <div class="kpi-value" id="rentPending">₹0</div>
  <div class="kpi-sub">किराया बकाया</div>
 </div>

 <div class="kpi">
  <div class="kpi-title">Electricity Bill</div>
  <div class="kpi-value" id="electricityTotal">₹0</div>
  <div class="kpi-sub">कुल बिजली बिल</div>
 </div>

 <div class="kpi">
  <div class="kpi-title">Electricity Paid</div>
  <div class="kpi-value" id="electricityPaid">₹0</div>
  <div class="kpi-sub">बिजली प्राप्त</div>
 </div>

 <div class="kpi">
  <div class="kpi-title">Electricity Due</div>
  <div class="kpi-value" id="electricityPending">₹0</div>
  <div class="kpi-sub">बिजली बकाया</div>
 </div>

 <div class="kpi">
  <div class="kpi-title">Total Outstanding</div>
  <div class="kpi-value" id="grandPending">₹0</div>
  <div class="kpi-sub">Rent + Electricity</div>
 </div>

</section>


<!-- ANALYTICS -->

<section class="grid">

 <div class="card">

  <h2>
   📊 Rent Collection
   <span>किराया कलेक्शन</span>
  </h2>

  <div class="donut-wrap">

   <div class="donut" id="rentDonut"
        style="--collection:0">

    <div class="donut-center">
     <strong id="rentPercent">0%</strong>
     <small>Collected</small>
    </div>

   </div>

   <div class="legend">

    <div class="legend-row">
     <span class="dot green"></span>
     <div>
      <b>Collected</b><br>
      <span id="legendRentPaid">₹0</span>
     </div>
    </div>

    <div class="legend-row">
     <span class="dot red"></span>
     <div>
      <b>Pending</b><br>
      <span id="legendRentPending">₹0</span>
     </div>
    </div>

   </div>

  </div>

 </div>


 <div class="card">

  <h2>⚡ Electricity Collection</h2>

  <div class="bar-row">

   <div class="bar-head">
    <span>Electricity Paid</span>
    <strong id="electricityPaidPercent">0%</strong>
   </div>

   <div class="bar">
    <div class="bar-fill"
         id="electricityPaidBar"
         style="background:var(--cyan)">
    </div>
   </div>

  </div>

  <div class="bar-row">

   <div class="bar-head">
    <span>Electricity Pending</span>
    <strong id="electricityPendingPercent">0%</strong>
   </div>

   <div class="bar">
    <div class="bar-fill"
         id="electricityPendingBar"
         style="background:var(--red)">
    </div>
   </div>

  </div>

  <div style="
   margin-top:20px;
   padding:15px;
   border-radius:12px;
   background:rgba(25,216,255,.06);
   border:1px solid rgba(25,216,255,.15);
  ">

   <div style="color:var(--muted);font-size:11px">
    TOTAL ELECTRICITY
   </div>

   <div id="electricityGraphTotal"
        style="font-size:25px;font-weight:850;color:var(--cyan)">
    ₹0
   </div>

  </div>

 </div>


 <div class="card">

  <h2>💳 Payment Status</h2>

  <div class="bar-row">
   <div class="bar-head">
    <span>🟢 Fully Paid</span>
    <strong id="fullyPaid">0</strong>
   </div>

   <div class="bar">
    <div id="barPaid"
         class="bar-fill"
         style="background:var(--green)">
    </div>
   </div>
  </div>

  <div class="bar-row">
   <div class="bar-head">
    <span>🟠 Partial</span>
    <strong id="partialPaid">0</strong>
   </div>

   <div class="bar">
    <div id="barPartial"
         class="bar-fill"
         style="background:var(--orange)">
    </div>
   </div>
  </div>

  <div class="bar-row">
   <div class="bar-head">
    <span>🔴 No Payment</span>
    <strong id="unpaid">0</strong>
   </div>

   <div class="bar">
    <div id="barUnpaid"
         class="bar-fill"
         style="background:var(--red)">
    </div>
   </div>
  </div>

 </div>

</section>


<!-- TABLE -->

<section class="card table-card">

 <div class="table-header">

  <div>
   <h2 style="margin:0;color:var(--gold2)">
    🧾 ROOM-WISE RENT & ELECTRICITY REGISTER
   </h2>

   <small style="color:var(--muted)">
    Viewer Mode • Login required for editing
   </small>
  </div>

  <div class="table-tools">

   <input
    class="search"
    id="search"
    placeholder="🔎 Room या नाम खोजें..."
    oninput="renderTable()"
   >

   <button class="btn"
           onclick="sortByDue()">
    ↕ Due Sort
   </button>

  </div>

 </div>


 <div class="table-wrap">

  <table>

   <thead>

    <tr>
     <th>ROOM</th>
     <th>किरायेदार</th>
     <th>RENT DUE</th>
     <th>RENT PAID</th>
     <th>RENT PENDING</th>

     <th>ELECTRIC UNITS</th>
     <th>RATE / UNIT</th>
     <th>ELECTRIC BILL</th>
     <th>ELECTRIC PAID</th>
     <th>ELECTRIC PENDING</th>

     <th>STATUS</th>
     <th>ACTION</th>
    </tr>

   </thead>

   <tbody id="roomTable"></tbody>

  </table>

 </div>

</section>


<!-- DUE -->

<section class="grid">

 <div class="card" style="grid-column:span 2">

  <h2>
   🔴 Outstanding Collection
   <span>किराया + बिजली</span>
  </h2>

  <div class="dues" id="dueList"></div>

 </div>


 <div class="card">

  <h2>⚡ Management Insights</h2>

  <div id="insights"></div>

 </div>

</section>


<footer class="footer">

 <div style="font-size:22px;margin-bottom:7px">◈</div>

 Product Architect:
 <strong>darklight000999</strong>

 <br>

 Rental & Utility Management System

 <br><br>

 Copyright © 2026
 <strong>darklight000999 Technologies</strong>

</footer>

</div>


<!-- LOGIN MODAL -->

<div class="modal" id="loginModal">

 <div class="modal-box"
      style="max-width:420px">

  <div class="login-icon">🔐</div>

  <h2 style="
   text-align:center;
   color:var(--gold2);
   margin:15px 0 5px;
  ">
   ADMIN ACCESS
  </h2>

  <p style="
   text-align:center;
   color:var(--muted);
   font-size:11px;
  ">
   Secure management panel
  </p>

  <div class="form-grid"
       style="margin-top:20px">

   <div class="form-group full">
    <label>Admin User ID</label>
    <input
     id="adminUser"
     autocomplete="username"
     placeholder="Enter User ID"
    >
   </div>

   <div class="form-group full">
    <label>Password</label>
    <input
     id="adminPass"
     type="password"
     autocomplete="current-password"
     placeholder="Enter Password"
     onkeydown="if(event.key==='Enter')login()"
    >
   </div>

  </div>

  <div class="login-note">
   🔒 बिना Admin Login के कोई data modification,
   add, delete, rent/electricity payment update या
   backup/restore संभव नहीं है।
  </div>

  <div class="form-actions">

   <button class="btn"
           onclick="closeLogin()">
    Cancel
   </button>

   <button class="btn gold"
           onclick="login()">
    🔓 Login
   </button>

  </div>

