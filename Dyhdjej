 }

}


function logout(){

 isAdmin=false;

 sessionStorage.removeItem(
  "rentalAdmin"
 );

 applyAdminMode();

 showToast("🔒 Admin Logout — Viewer Mode");

}


/* ================= SAVE ================= */

function save(){

 localStorage.setItem(
  "darklightRentalRooms",
  JSON.stringify(rooms)
 );

}


/* ================= MONEY ================= */

function money(v){

 return "₹"+Number(v||0)
 .toLocaleString("en-IN");

}


/* ================= ESCAPE ================= */

function escapeHTML(str){

 return String(str)
 .replaceAll("&","&amp;")
 .replaceAll("<","&lt;")
 .replaceAll(">","&gt;")
 .replaceAll('"',"&quot;")
 .replaceAll("'","&#039;");

}


/* ================= CALCULATE ================= */

function calculate(){

 const rentDue =
  rooms.reduce(
   (s,r)=>s+Number(r.due||0),0
  );

 const rentPaid =
  rooms.reduce(
   (s,r)=>s+Number(r.received||0),0
  );

 const rentPending =
  Math.max(0,rentDue-rentPaid);


 const electricity =
  rooms.reduce(
   (s,r)=>{

    let bill=Number(r.electricBill||0);

    if(
     bill<=0 &&
     Number(r.units||0)>0
    ){

     bill =
      Number(r.units||0) *
      Number(r.rate||0);

    }

    return s+bill;

   },0
  );


 const electricPaid =
  rooms.reduce(
   (s,r)=>s+Number(r.electricPaid||0),0
  );


 const electricPending =
  Math.max(
   0,
   electricity-electricPaid
  );


 const totalPending =
  rentPending+electricPending;


 const rentRate =
  rentDue>0
   ? rentPaid/rentDue*100
   : 0;


 const electricRate =
  electricity>0
   ? electricPaid/electricity*100
   : 0;


 const paid =
  rooms.filter(
   r=>Number(r.received)>=Number(r.due)
   && Number(r.due)>0
  ).length;


 const partial =
  rooms.filter(
   r=>Number(r.received)>0 &&
   Number(r.received)<Number(r.due)
  ).length;


 const unpaid =
  rooms.filter(
   r=>Number(r.received)<=0
  ).length;


 return {
  rentDue,
  rentPaid,
  rentPending,
  electricity,
  electricPaid,
  electricPending,
  totalPending,
  rentRate,
  electricRate,
  paid,
  partial,
  unpaid
 };

}


